<?xml version="1.0"?>
<sdf version="1.6">
  <model name="cabinet">
    <static>true</static>
    <link name="body">
      <visual name="visual">
        <geometry>
          <box>
            <size>0.8 0.6 2.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.35 1</ambient>
          <diffuse>0.4 0.4 0.45 1</diffuse>
          <specular>0.2 0.2 0.2 1</specular>
        </material>
      </visual>
      <collision name="collision">
        <geometry>
          <box>
            <size>0.8 0.6 2.2</size>
          </box>
        </geometry>
      </collision>
      <!-- Cabinet door frame -->
      <visual name="door_frame">
        <pose>0.41 0 0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.55 2.0</size>
          </box>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.25 1</ambient>
          <diffuse>0.25 0.25 0.3 1</diffuse>
        </material>
      </visual>
      <!-- Indicator panel -->
      <visual name="indicator">
        <pose>0.41 0 0.6 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.3 0.2</size>
          </box>
        </geometry>
        <material>
          <ambient>0.1 0.1 0.1 1</ambient>
          <diffuse>0.15 0.15 0.15 1</diffuse>
        </material>
      </visual>
      <!-- Status light (green) -->
      <visual name="status_light">
        <pose>0.42 0.08 0.65 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0 0.8 0 1</ambient>
          <diffuse>0 1 0 1</diffuse>
          <emissive>0 0.5 0 1</emissive>
        </material>
      </visual>
      <!-- Warning light (red) -->
      <visual name="warning_light">
        <pose>0.42 -0.08 0.65 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.015</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.8 0 0 1</ambient>
          <diffuse>1 0 0 1</diffuse>
        </material>
      </visual>
      <!-- Ventilation grille -->
      <visual name="vent">
        <pose>0.41 0 -0.8 0 0 0</pose>
        <geometry>
          <box>
            <size>0.02 0.4 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.15 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
