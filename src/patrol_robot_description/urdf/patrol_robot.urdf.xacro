<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="patrol_robot">

  <!-- Include all components -->
  <xacro:include filename="$(find patrol_robot_description)/urdf/common_properties.xacro"/>
  <xacro:include filename="$(find patrol_robot_description)/urdf/robot_base.xacro"/>
  <xacro:include filename="$(find patrol_robot_description)/urdf/lidar.xacro"/>
  <xacro:include filename="$(find patrol_robot_description)/urdf/camera.xacro"/>
  <xacro:include filename="$(find patrol_robot_description)/urdf/gazebo_plugins.xacro"/>

  <!-- Build the robot -->
  <xacro:robot_base/>
  <xacro:lidar parent="base_link"/>
  <xacro:camera parent="base_link"/>
  <xacro:gazebo_plugins/>

</robot>
