          <material><ambient>1 1 0 1</ambient><diffuse>1 1 0.2 1</diffuse><emissive>0.5 0.5 0 1</emissive></material></visual>
        <!-- 高位仪表盘 3A-3D (北面) -->
        <visual name="meter_3A"><pose>-3 0.31 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="meter_3A_ring"><pose>-3 0.32 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="meter_3B"><pose>-1 0.31 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="meter_3B_ring"><pose>-1 0.32 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="meter_3C"><pose>1 0.31 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="meter_3C_ring"><pose>1 0.32 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="meter_3D"><pose>3 0.31 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.12</radius><length>0.02</length></cylinder></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="meter_3D_ring"><pose>3 0.32 0.85 1.57 0 0</pose><geometry><cylinder><radius>0.13</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Row 4: Y=-8 柜子排 + 标记 4A(红) 4B(绿) 4C(蓝) 4D(黄) -->
    <model name="cabinet_row_4">
      <static>true</static>
      <pose>0 -8 1.1 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>8 0.6 2.2</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>8 0.6 2.2</size></box></geometry>
          <material><ambient>0.3 0.32 0.38 1</ambient><diffuse>0.35 0.37 0.42 1</diffuse></material></visual>
