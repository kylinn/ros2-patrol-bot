        <!-- 标记 3C(蓝) x=1 -->
        <visual name="mark_3C"><pose>1 0.31 0.5 0 0 0</pose><geometry><box><size>0.3 0.02 0.3</size></box></geometry>
          <material><ambient>0 0 1 1</ambient><diffuse>0.2 0.2 1 1</diffuse><emissive>0 0 0.5 1</emissive></material></visual>
        <!-- 标记 3D(黄) x=3 -->
